          { "id": "n5", "kind": "webhook", "position": [0, 0], "fields": { "url": "https://hooks.example.com/b", "events": ["lesson_plan.ready"] }, "script": null, "custom": false, "script_name": null, "params": {} }
        ],
        "edges": [ { "from": "n1", "to": "n2" }, { "from": "n4", "to": "n5" } ]
      },
      "recorded": { "n1": { "id": "rt-client-1" }, "n2": { "id": "rt-hook-1" }, "n4": { "id": "rt-client-gone" }, "n5": { "id": "rt-hook-5" } },
      "live": {
        "oauth_client": [ { "id": "po-client-1", "runtime_id": "rt-client-1", "parent_id": null } ],
        "webhook_out": [
          { "id": "po-hook-1", "runtime_id": "rt-hook-1", "parent_id": "po-client-9" },
          { "id": "po-hook-5", "runtime_id": "rt-hook-5", "parent_id": "po-client-gone" }
        ],
        "app": []
      },
      "expect": {
        "kept": { "n1": "rt-client-1" },
        "ops": [
          { "handle": "n1", "kind": "client", "op": "update", "id": "rt-client-1", "body": { "name": "Game server", "scopes": ["events:write"] } },
          { "handle": "n2", "kind": "webhook", "op": "create", "client": { "handle": "n1" }, "body": { "url": "https://hooks.example.com/a", "event_types": ["lesson_plan.ready"] } },
          { "handle": "n4", "kind": "client", "op": "create", "body": { "name": "Second", "scopes": [], "billing_mode": "allowance" } },
          { "handle": "n5", "kind": "webhook", "op": "create", "client": { "handle": "n4" }, "body": { "url": "https://hooks.example.com/b", "event_types": ["lesson_plan.ready"] } }
        ]
      },
      "verdicts": [
        { "handle": "n1", "kind": "client", "op": "update", "verdict": "would_update", "changes": ["name"] },
        { "handle": "n2", "kind": "webhook", "op": "create", "verdict": "would_create" },
        { "handle": "n4", "kind": "client", "op": "create", "verdict": "would_create" },
        { "handle": "n5", "kind": "webhook", "op": "create", "verdict": "would_create" }
      ],
      "steps": [
        { "handle": "n1", "action": "update", "records": "unchanged", "argv": ["oauth_client", "update", "po-client-1", "--name", "Game server", "--scope", "events:write"] },
        { "handle": "n2", "action": "create", "records": "runtime_id", "argv": ["webhook", "outbound", "create", "--client", "po-client-1", "--url", "https://hooks.example.com/a", "--event", "lesson_plan.ready"] },
        { "handle": "n4", "action": "create", "records": "runtime_id", "argv": ["oauth_client", "create", "--name", "Second"] },
        { "handle": "n5", "action": "create", "records": "runtime_id", "argv": ["webhook", "outbound", "create", "--client", "<n4>", "--url", "https://hooks.example.com/b", "--event", "lesson_plan.ready"] }
      ]
    },
    {
