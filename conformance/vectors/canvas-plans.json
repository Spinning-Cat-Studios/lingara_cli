{
  "schema": 1,
  "about": "ADR 16.10.26ad D7: canvas apply's plan rules, pinned for every kit. Each vector is a saved draft (definition and recorded runtime ids), the live oauth_client / webhook_out / app list rows, and what the planner must make of them: the kept records and the dry-run ops, or the node a refusal names. Where `verdicts` is given, `steps` are the argvs apply runs for them (an id made earlier in the run is `<handle>`, an app op's manifest file `<handle.manifest>`), or `stop` is why apply stops before any write. The web's plan.ts is the source of these rules; nothing ties it to this file mechanically, so a change there updates this file by hand.",
  "vectors": [
    {
      "name": "a fresh recipe plans every field node as a create, in topological order",
      "definition": {
        "schema": 2,
        "nodes": [
          { "id": "n3", "kind": "webhook", "position": [0, 0], "fields": { "url": "https://hooks.example.com/lingara", "events": ["lesson_plan.ready"] }, "script": null, "custom": false, "script_name": null, "params": {} },
          { "id": "n1", "kind": "client", "position": [0, 0], "fields": { "name": "My server", "scopes": ["events:read"] }, "script": null, "custom": false, "script_name": null, "params": {} },
          { "id": "n2", "kind": "secret", "position": [0, 0], "fields": {}, "script": null, "custom": false, "script_name": null, "params": {} }
        ],
        "edges": [ { "from": "n1", "to": "n2" }, { "from": "n1", "to": "n3" } ]
      },
      "recorded": {},
      "live": { "oauth_client": [], "webhook_out": [], "app": [] },
      "expect": {
        "kept": {},
        "ops": [
          { "handle": "n1", "kind": "client", "op": "create", "body": { "name": "My server", "scopes": ["events:read"], "billing_mode": "allowance" } },
          { "handle": "n3", "kind": "webhook", "op": "create", "client": { "handle": "n1" }, "body": { "url": "https://hooks.example.com/lingara", "event_types": ["lesson_plan.ready"] } },
          { "handle": "n2", "kind": "secret", "op": "create", "client": { "handle": "n1" } }
        ]
      },
      "verdicts": [
        { "handle": "n1", "kind": "client", "op": "create", "verdict": "would_create" },
        { "handle": "n3", "kind": "webhook", "op": "create", "verdict": "would_create", "depends_on": ["n1"] },
        { "handle": "n2", "kind": "secret", "op": "create", "verdict": "would_create", "note": "minted_with_client", "depends_on": ["n1"] }
      ],
      "steps": [
        { "handle": "n1", "action": "create", "records": "runtime_id", "argv": ["oauth_client", "create", "--name", "My server", "--scope", "events:read"] },
        { "handle": "n3", "action": "create", "records": "runtime_id", "argv": ["webhook", "outbound", "create", "--client", "<n1>", "--url", "https://hooks.example.com/lingara", "--event", "lesson_plan.ready"] },
        { "handle": "n2", "action": "create", "records": "client_secret", "argv": [] }
      ]
    },
    {
      "name": "a re-apply keeps live records, plans them as updates, and applies only what changed",
      "definition": {
        "schema": 2,
        "nodes": [
          { "id": "n1", "kind": "client", "position": [0, 0], "fields": { "name": "My server", "scopes": ["events:read"], "redirectUris": ["https://example.com/cb"] }, "script": null, "custom": false, "script_name": null, "params": {} },
          { "id": "n2", "kind": "secret", "position": [0, 0], "fields": {}, "script": null, "custom": false, "script_name": null, "params": {} },
          { "id": "n3", "kind": "webhook", "position": [0, 0], "fields": { "url": "https://hooks.example.com/v2", "events": ["lesson_plan.ready"] }, "script": null, "custom": false, "script_name": null, "params": {} }
        ],
        "edges": [ { "from": "n1", "to": "n2" }, { "from": "n1", "to": "n3" } ]
      },
      "recorded": { "n1": { "id": "rt-client-1" }, "n2": { "id": "secret-1" }, "n3": { "id": "rt-hook-1" } },
      "live": {
        "oauth_client": [ { "id": "po-client-1", "runtime_id": "rt-client-1", "parent_id": null } ],
        "webhook_out": [ { "id": "po-hook-1", "runtime_id": "rt-hook-1", "parent_id": "po-client-1" } ],
        "app": []
      },
      "expect": {
        "kept": { "n1": "rt-client-1", "n2": "secret-1", "n3": "rt-hook-1" },
        "ops": [
          { "handle": "n1", "kind": "client", "op": "update", "id": "rt-client-1", "body": { "name": "My server", "scopes": ["events:read"], "redirect_uris": ["https://example.com/cb"] } },
          { "handle": "n3", "kind": "webhook", "op": "update", "id": "rt-hook-1", "body": { "url": "https://hooks.example.com/v2", "event_types": ["lesson_plan.ready"] } }
        ]
      },
      "verdicts": [
        { "handle": "n1", "kind": "client", "op": "update", "verdict": "would_update", "changes": [] },
        { "handle": "n3", "kind": "webhook", "op": "update", "verdict": "would_update", "changes": ["url", "enabled"] }
      ],
      "steps": [
        { "handle": "n1", "action": "unchanged", "records": "unchanged", "argv": [] },
        { "handle": "n3", "action": "update", "records": "unchanged", "argv": ["webhook", "outbound", "update", "po-hook-1", "--url", "https://hooks.example.com/v2", "--enable"] }
      ]
    },
    {
