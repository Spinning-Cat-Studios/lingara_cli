      "steps": [
        { "handle": "n1", "action": "create", "records": "runtime_id", "argv": ["oauth_client", "create", "--name", "Cards", "--scope", "vocab:read"] },
        { "handle": "n2", "action": "create", "records": "runtime_id", "argv": ["apps", "create", "Flashcards", "--client", "<n1>", "--manifest", "<n2.manifest>"] }
